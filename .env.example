# ============================================================
# VELTRIX ERP - CONFIGURACIÓN DE PRODUCCIÓN / ENTORNOS
# ============================================================

# Opción A: Desarrollo local o Servidor VPS propio (SQLite persistente)
# Para desarrollo local:
DATABASE_URL="file:./dev.db"
# Para Docker Compose con volumen persistente en VPS:
# DATABASE_URL="file:/app/data/dev.db"

# Opción B: Despliegue en la Nube / Serverless (Vercel, Netlify, Railway) con Turso:
# DATABASE_URL="libsql://veltrix-db-[tu-usuario].turso.io"
# TURSO_AUTH_TOKEN="tu-token-generado-en-turso"

# 2. AUTENTICACIÓN (NextAuth):
# En producción debe ser tu dominio real con HTTPS (ej: https://veltrix.tudominio.com o https://veltrix.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# Clave secreta criptográfica para firmar JWTs (Generar con: openssl rand -base64 32)
NEXTAUTH_SECRET="genera-un-secreto-aleatorio-de-32-caracteres-para-produccion"

# 3. SEGURIDAD Y PRIMER ACCESO:
# Contraseña inicial asignada al usuario admin@erp.com durante 'npm run db:seed'
INITIAL_ADMIN_PASSWORD="TuClaveSegura2026!*"
